{
  "name": "auto-apply-bot",
  "version": "1.0.0",
  "description": "Agente inteligente de candidatura automatica a vagas de emprego",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "resultado": "tsx src/marcar-resultado.ts",
    "chrome": "tsx src/abrir-chrome.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src tests vitest.config.ts",
    "test:smoke": "vitest run tests/smoke.test.ts",
    "start:built": "node dist/index.js"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@playwright/mcp": "0.0.76",
    "better-sqlite3": "13.0.3",
    "dotenv": "^16.4.0",
    "nodemailer": "10.2.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "26.6.5",
    "@types/nodemailer": "7.0.12",
    "eslint": "10.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=24.22.1 <25 || >=26.12.1 <27",
    "npm": ">=11.19.1 <12"
  },
  "packageManager": "npm@11.19.1",
  "allowScripts": {
    "better-sqlite3": false,
    "esbuild": true,
    "protobufjs": true
  }
}
